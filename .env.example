# BLASTA configuration template.
#
# Copy this file to `.env` (which is git-ignored) and uncomment what you need:
#
#     cp .env.example .env
#
# docker compose reads `.env` automatically. Nothing here is required: BLASTA starts with
# sensible defaults, and most of these can also be changed later in the web UI under
# Settings (what you save there wins over the values here). Never commit a real `.env`.

# ---- Where it listens ---------------------------------------------------------------
# Host port the container is published on (loopback only; see docs/PROXY.md to expose it).
#BLASTA_PORT=8080
# The address people use to reach BLASTA from outside, e.g. the one your reverse proxy
# publishes. Include a path if BLASTA lives under one (https://example.com/blasta).
#BLASTA_PUBLIC_URL=https://blasta.example.com
# Serve under a path prefix such as /blasta when your proxy does not strip it.
#BLASTA_BASE_PATH=
# Reverse proxies whose X-Forwarded-For header may be believed: addresses, ranges, or
# `private` (loopback + private networks, which covers Docker and most clusters).
#BLASTA_TRUSTED_PROXIES=private

# ---- Sign-in and registration -------------------------------------------------------
# Turn sign-in on or off. Keep it on unless BLASTA is reachable only by you on loopback.
#BLASTA_AUTH=true
# open | approval | closed. With email set up, new people confirm their address first.
#BLASTA_REGISTRATION=open
# Only these email domains may register / sign in with SSO (comma separated).
#BLASTA_ALLOWED_EMAIL_DOMAINS=example.com,example.org
# Required to create the very first (administrator) account, so nobody else can claim a
# freshly deployed instance. Use a long random value.
#BLASTA_SETUP_TOKEN=change-me-to-a-long-random-string
# A few small, time-limited tests for visitors without an account.
#BLASTA_GUEST=true
# Sign in with an emailed one-time code (needs the SMTP settings below).
#BLASTA_OTP_LOGIN=false
# Turn off "forgot password" emails.
#BLASTA_DISABLE_PASSWORD_RESET=false
# Session limits (Go durations).
#BLASTA_SESSION_IDLE=12h
#BLASTA_SESSION_MAX=168h

# ---- Storage ------------------------------------------------------------------------
# SQLite in the data directory is the default (/data in the container). To use another
# database: sqlite:/path/to/blasta.db, postgres://user:pass@host:5432/blasta or
# mysql://user:pass@host:3306/blasta (MariaDB works too).
#BLASTA_DATABASE_URL=
# Key material that encrypts saved secrets (SMTP password, SSO client secret, bot-check
# key). If unset, a random key is created once in secret.key next to the database. Set the
# SAME value on every replica sharing one database. Keep it with your backups.
#BLASTA_SECRET_KEY=

# ---- Email (also configurable in Settings > Email Delivery) -------------------------
#BLASTA_SMTP_HOST=smtp.example.com
#BLASTA_SMTP_PORT=587
# starttls | tls | none
#BLASTA_SMTP_SECURITY=starttls
#BLASTA_SMTP_USER=
#BLASTA_SMTP_PASSWORD=
#BLASTA_SMTP_FROM=blasta@example.com
# The sender text shown in mail apps.
#BLASTA_SMTP_FROM_NAME=BLASTA by AWHADI

# ---- Single sign-on, OpenID Connect (also in Settings > Single Sign-On) -------------
#BLASTA_OIDC_NAME=Company SSO
#BLASTA_OIDC_ISSUER=https://login.example.com/realms/main
#BLASTA_OIDC_CLIENT_ID=blasta
#BLASTA_OIDC_CLIENT_SECRET=
# Only if BLASTA must reach the provider at a different address than users do.
#BLASTA_OIDC_DISCOVERY_URL=
#BLASTA_OIDC_SCOPES=openid email profile
# Create an account the first time someone signs in; active | pending for new accounts.
#BLASTA_OIDC_AUTO_CREATE=true
#BLASTA_OIDC_TRUST=active
#BLASTA_OIDC_ADMIN_EMAILS=
#BLASTA_OIDC_ADMIN_GROUP=
#BLASTA_OIDC_GROUPS_CLAIM=groups
# Development only: allow a plain http provider that is not on loopback.
#BLASTA_OIDC_ALLOW_INSECURE=false

# ---- Bot protection (also in Settings > Bot Protection) -----------------------------
# turnstile | recaptcha
#BLASTA_CAPTCHA_PROVIDER=turnstile
#BLASTA_CAPTCHA_SITE_KEY=
#BLASTA_CAPTCHA_SECRET_KEY=
# Emergency switch if a wrong key locks everyone out of sign-in.
#BLASTA_CAPTCHA_OFF=false

# ---- Database test jobs -------------------------------------------------------------
# Jobs that talk to a database read the connection string from an environment variable
# whose NAME you type in the UI. Define those variables here, for example:
#PG_DSN=postgres://user:pass@db.example.com:5432/app?sslmode=require
