{
  "id": "woocommerce",
  "title": "WooCommerce",
  "category": "E-commerce",
  "summary": "Shop, product, Store API, cart fragments and checkout on WordPress. Includes an enterprise test plan (jobs starting ent-).",
  "stack": "WordPress + WooCommerce + MySQL",
  "variables": [
    {
      "name": "url",
      "default": "https://example.com",
      "description": "Site base URL, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    },
    {
      "name": "product",
      "default": "sample-product",
      "description": "Slug of an existing product",
      "placeholder": true,
      "guide": "The slug of an existing product. Open a product on the shop; the slug is the last part of its address."
    }
  ],
  "jobs": [
    {
      "id": "shop",
      "name": "woocommerce shop page",
      "notes": "Product archive: a heavy query with taxonomy and meta joins.",
      "safety": "read",
      "job": {
        "name": "woocommerce shop page",
        "executor": "http",
        "target": {
          "url": "{{url}}/shop/"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 15,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "product",
      "name": "woocommerce product page",
      "notes": "Single product with price, stock and related products. Uncached to show the real cost.",
      "safety": "read",
      "job": {
        "name": "woocommerce product page",
        "executor": "http",
        "target": {
          "url": "{{url}}/product/{{product}}/"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        }
      }
    },
    {
      "id": "store-api",
      "name": "Store API products",
      "notes": "The block-based storefront reads this. Heavier than the classic pages because it serialises price and stock objects.",
      "safety": "read",
      "job": {
        "name": "Store API products",
        "executor": "http",
        "target": {
          "url": "{{url}}/wp-json/wc/store/v1/products?per_page=12"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 15,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "cart-fragments",
      "name": "cart fragments (wc-ajax)",
      "notes": "The classic bottleneck: it runs on every page view for visitors with a cart and bypasses page caching. Often the first thing to fall over on a busy shop.",
      "safety": "read",
      "job": {
        "name": "cart fragments (wc-ajax)",
        "executor": "http",
        "target": {
          "url": "{{url}}/?wc-ajax=get_refreshed_fragments"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 30,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "cart",
      "name": "cart page",
      "notes": "Anonymous cart. A fresh session is created per request because BLASTA sends no cookies.",
      "safety": "read",
      "job": {
        "name": "cart page",
        "executor": "http",
        "target": {
          "url": "{{url}}/cart/"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 15,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "checkout",
      "name": "checkout page",
