      "safety": "read",
      "job": {
        "name": "checkout page",
        "executor": "http",
        "target": {
          "url": "{{url}}/checkout/"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 5,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
