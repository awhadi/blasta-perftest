{
  "id": "drupal",
  "title": "Drupal",
  "category": "CMS",
  "summary": "Drupal front end, JSON:API, search and admin. Includes an enterprise test plan (jobs starting ent-).",
  "stack": "PHP + MySQL/PostgreSQL + nginx/Apache",
  "variables": [
    {
      "name": "url",
      "default": "https://example.com",
      "description": "Site base URL, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    },
    {
      "name": "node",
      "default": "1",
      "description": "Numeric node ID of published content, e.g. /node/1",
      "guide": "The number of a published page. Open it on the site: the address is /node/<number> (hover its title in Content in the admin if the site uses friendly URLs)."
    },
    {
      "name": "adminCookie",
      "default": "${DRUPAL_ADMIN_COOKIE}",
      "description": "Session cookie of a logged-in Drupal admin, copied from your browser (DevTools > Application > Cookies; the cookie named SESS... or SSESS...). Read from the DRUPAL_ADMIN_COOKIE env var; export it as name=value before running.",
      "sensitive": true
    }
  ],
  "jobs": [
    {
      "id": "front",
      "name": "drupal front page",
      "notes": "Baseline anonymous read.",
      "safety": "read",
      "job": {
        "name": "drupal front page",
        "executor": "http",
        "target": {
          "url": "{{url}}/"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "node",
      "name": "drupal node page",
      "notes": "Renders one entity through the render system: PHP plus several queries.",
      "safety": "read",
      "job": {
        "name": "drupal node page",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        }
      }
    },
    {
      "id": "jsonapi",
      "name": "drupal JSON:API collection",
      "notes": "The API most headless Drupal builds consume. Serialises entities, so it is heavy.",
      "safety": "read",
      "job": {
        "name": "drupal JSON:API collection",
        "executor": "http",
        "target": {
          "url": "{{url}}/jsonapi/node/article"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "application/vnd.api+json"
        }
      }
    },
    {
      "id": "search",
      "name": "drupal core search",
      "notes": "Core search hits the search index tables and degrades quickly on large sites.",
      "safety": "read",
      "job": {
        "name": "drupal core search",
        "executor": "http",
        "target": {
          "url": "{{url}}/search/node?keys=content"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 5,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false
      }
    },
    {
      "id": "views",
      "name": "drupal views listing",
      "notes": "pager queries on large sites are a classic bottleneck.",
      "safety": "read",
      "job": {
        "name": "drupal views listing",
        "executor": "http",
        "target": {
          "url": "{{url}}/?page=1"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false
      }
    },
    {
      "id": "admin",
      "name": "drupal admin overview",
      "notes": "Needs {{adminCookie}}. Writes session and cache data, so staging only.",
      "safety": "mutating",
      "job": {
        "name": "drupal admin overview",
        "executor": "http",
        "target": {
          "url": "{{url}}/admin"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 5,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Cookie": "{{adminCookie}}"
        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "Drupal: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "Drupal: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 4,
        "rps": 5,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "Drupal: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "Drupal: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "Drupal: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 80,
        "rps": 100,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "Drupal: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 250,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 1250,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "Drupal: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 07 recovery after the spike",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "Drupal: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 08 soak (1 hour at 60%)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 12,
        "rps": 15,
        "duration": 3600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "Drupal: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 09 breakpoint (find the ceiling)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 400,
        "rps": 500,
        "duration": 1380000000000,
        "timeout": 15000000000,
        "queueSize": 2500,
        "onQueueFull": "reject",
        "maxWorkers": 800,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "Drupal: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: 10 resilience window (failover / deploy)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 900000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-connection-close",
      "name": "Drupal: no keep-alive (new connection per request)",
      "notes": "Sends Connection: close, so every request pays for a new TCP and TLS handshake: the cost for clients that do not reuse connections (scripts, some mobile SDKs, health checkers). Shows load balancer and TLS termination limits. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: no keep-alive (new connection per request)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Connection": "close"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1500000000,
          "maxP99": 3000000000
        }
      }
    },
    {
      "id": "ent-x-bot-traffic",
      "name": "Drupal: crawler traffic (Googlebot user agent)",
      "notes": "Same request identified as a search crawler. Tests WAF and bot-management rules and whether crawlers get cached or origin responses. Crawlers can easily be a third of all traffic. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: crawler traffic (Googlebot user agent)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "User-Agent": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-large-headers",
      "name": "Drupal: large cookies (~4 KB header)",
      "notes": "Adds a 4 KB Cookie header, like a logged-in user with many tracking cookies. Proxies and servers reject headers around 8 KB, so this shows how close you are to that limit. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: large cookies (~4 KB header)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 12,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Cookie": ""
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-monitor-storm",
      "name": "Drupal: uptime monitors (HEAD from many locations)",
      "notes": "A fleet of synthetic monitors checking the URL with HEAD requests every 30 seconds from 20 locations, plus load balancer probes. Cheap each, constant in total. Reference request: drupal node page.",
      "safety": "read",
      "job": {
        "name": "Drupal: uptime monitors (HEAD from many locations)",
        "executor": "http",
        "target": {
          "url": "{{url}}/node/{{node}}"
        },
        "method": "HEAD",
        "concurrency": 20,
        "rps": 25,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache"
        },
        "expectStatus": [
          200,
          204,
          301,
          302,
          304,
          405
        ],
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    }
  ],
  "secrets": {
    "DRUPAL_ADMIN_COOKIE": {
      "label": "Drupal admin session cookie",
      "guide": "1. Log in to your STAGING Drupal site as an administrator.\n2. Open developer tools (F12), then Application or Storage, then Cookies.\n3. Copy the cookie named `SESS<hash>` (or `SSESS<hash>` over HTTPS) as name=value.\nIt expires when you log out, so get a fresh one before each run."
    }
  }
}
