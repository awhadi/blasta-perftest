{
  "id": "auth-api",
  "title": "Authenticated APIs",
  "category": "API",
  "summary": "Bearer tokens, API keys, login endpoints, unauthorised requests and CORS preflight. Includes an enterprise test plan (jobs starting ent-).",
  "description": "Load tests APIs that sit behind authentication: requests with a bearer token or an API key, the login endpoint, unauthenticated calls that must be refused with 401, and CORS preflight requests. It shows what authentication costs per request and confirms that rejected requests stay cheap and correct under load.",
  "stack": "REST APIs behind authentication",
  "variables": [
    {
      "name": "url",
      "default": "https://example.com",
      "description": "Base URL, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    },
    {
      "name": "endpoint",
      "default": "/api/v1/me",
      "description": "An authenticated endpoint",
      "guide": "An API path that requires authentication, starting with /, for example /api/v1/me."
    },
    {
      "name": "loginPath",
      "default": "/api/v1/login",
      "description": "Login endpoint (POST JSON)",
      "guide": "The path of the login endpoint or handler, starting with /."
    },
    {
      "name": "token",
      "default": "${API_TOKEN}",
      "description": "Bearer token. Read from the API_TOKEN env var by the CLI.",
      "sensitive": true
    },
    {
      "name": "apiKey",
      "default": "${API_KEY}",
      "description": "API key. Read from the API_KEY env var by the CLI.",
      "sensitive": true
    },
    {
      "name": "origin",
      "default": "https://app.example.com",
      "description": "Origin your browser app sends",
      "placeholder": true,
      "guide": "The Origin your browser app sends, for example https://app.example.com. Open the app, DevTools \u2192 Network, and read the Origin header on an API call."
    }
  ],
  "jobs": [
    {
      "id": "bearer",
      "name": "bearer token request",
      "notes": "The steady-state cost of an authenticated call: token validation plus the handler.",
      "safety": "read",
      "job": {
        "name": "bearer token request",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        }
      }
    },
    {
      "id": "api-key",
      "name": "API key header request",
      "notes": "Same, with an API key. Slower than a bearer token if the key is looked up in a database each time.",
      "safety": "read",
      "job": {
        "name": "API key header request",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "X-API-Key": "{{apiKey}}"
        }
      }
    },
    {
      "id": "unauthorised",
      "name": "unauthenticated request (expect 401)",
      "notes": "Rejected requests should be cheaper than accepted ones. If they are not, an attacker can load you without a credential.",
      "safety": "read",
      "job": {
        "name": "unauthenticated request (expect 401)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 100,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          401,
          403
        ],
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "login",
      "name": "login endpoint (POST)",
      "notes": "Password hashing is deliberately expensive, so login is usually the first thing to saturate CPU. Edit the JSON body for your API. This creates sessions, so staging only.",
      "safety": "mutating",
      "job": {
        "name": "login endpoint (POST)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{loginPath}}"
        },
        "method": "POST",
        "concurrency": 5,
        "rps": 5,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": "{\"username\":\"loadtest\",\"password\":\"change-me\"}"
      }
    },
    {
      "id": "cors-preflight",
      "name": "CORS preflight (OPTIONS)",
      "notes": "Browsers send one before most cross-origin calls, so it multiplies your API traffic. It should be answered by the edge, not the application.",
      "safety": "read",
      "job": {
        "name": "CORS preflight (OPTIONS)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "OPTIONS",
        "concurrency": 20,
        "rps": 100,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          204
        ],
        "headers": {
          "Origin": "{{origin}}",
          "Access-Control-Request-Method": "GET",
          "Access-Control-Request-Headers": "authorization"
        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "Authenticated APIs: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "Authenticated APIs: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 4,
        "rps": 10,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "Authenticated APIs: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "Authenticated APIs: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 100,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "Authenticated APIs: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 80,
        "rps": 200,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "Authenticated APIs: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 500,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 2500,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "Authenticated APIs: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 07 recovery after the spike",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "Authenticated APIs: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 08 soak (1 hour at 60%)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 12,
        "rps": 30,
        "duration": 3600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "Authenticated APIs: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 09 breakpoint (find the ceiling)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 400,
        "rps": 1000,
        "duration": 1380000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 800,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "Authenticated APIs: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: 10 resilience window (failover / deploy)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 900000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-connection-close",
      "name": "Authenticated APIs: no keep-alive (new connection per request)",
      "notes": "Sends Connection: close, so every request pays for a new TCP and TLS handshake: the cost for clients that do not reuse connections (scripts, some mobile SDKs, health checkers). Shows load balancer and TLS termination limits. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: no keep-alive (new connection per request)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}",
          "Connection": "close"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1500000000,
          "maxP99": 3000000000
        }
      }
    },
    {
      "id": "ent-x-bot-traffic",
      "name": "Authenticated APIs: crawler traffic (Googlebot user agent)",
      "notes": "Same request identified as a search crawler. Tests WAF and bot-management rules and whether crawlers get cached or origin responses. Crawlers can easily be a third of all traffic. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: crawler traffic (Googlebot user agent)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}",
          "User-Agent": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-large-headers",
      "name": "Authenticated APIs: large cookies (~4 KB header)",
      "notes": "Adds a 4 KB Cookie header, like a logged-in user with many tracking cookies. Proxies and servers reject headers around 8 KB, so this shows how close you are to that limit. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: large cookies (~4 KB header)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}",
          "Cookie": ""
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-monitor-storm",
      "name": "Authenticated APIs: uptime monitors (HEAD from many locations)",
      "notes": "A fleet of synthetic monitors checking the URL with HEAD requests every 30 seconds from 20 locations, plus load balancer probes. Cheap each, constant in total. Reference request: bearer token request.",
      "safety": "read",
      "job": {
        "name": "Authenticated APIs: uptime monitors (HEAD from many locations)",
        "executor": "http",
        "target": {
          "url": "{{url}}{{endpoint}}"
        },
        "method": "HEAD",
        "concurrency": 20,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          204,
          301,
          302,
          304,
          405
        ],
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer {{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    }
  ],
  "secrets": {
    "API_KEY": {
      "label": "API key",
      "guide": "In the service's admin look for Settings \u2192 API keys (or Developer, or Integrations), create a key for testing and copy it. Give it read-only rights if the job only reads."
    },
    "API_TOKEN": {
      "label": "API bearer token",
      "guide": "Usually Settings \u2192 API tokens (or Personal access tokens) in the service's admin: create a token for testing and copy it.\nFor an OAuth or OIDC service, request one: `curl -s -d grant_type=client_credentials -d client_id=ID -d client_secret=SECRET https://IDP/token` and copy `access_token`.\nTokens expire (often after 5 to 60 minutes), so create a long-lived one for long runs."
    }
  }
}
