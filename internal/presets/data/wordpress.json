{
  "id": "wordpress",
  "title": "WordPress",
  "category": "CMS",
  "summary": "Core front end, REST API, search and wp-admin. Includes an enterprise test plan (jobs starting ent-).",
  "description": "Load tests WordPress: the front page, a single post bypassing the page cache, REST API posts, search, the RSS feed and the wp-admin dashboard, plus a capacity ramp and a ten-minute soak. It shows what your page cache saves and how much PHP and MySQL can take on their own.",
  "stack": "PHP + MySQL/MariaDB + nginx/Apache",
  "variables": [
    {
      "name": "url",
      "default": "https://example.com",
      "description": "Site base URL, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    },
    {
      "name": "post",
      "default": "hello-world",
      "description": "Slug of an existing post, from its permalink",
      "placeholder": true,
      "guide": "Open any published post on your site. The slug is the last part of its address: https://yoursite.com/<slug>/.\nIn the admin: Posts \u2192 All Posts \u2192 hover a title \u2192 the slug is in Quick Edit."
    },
    {
      "name": "adminCookie",
      "default": "${WP_ADMIN_COOKIE}",
      "description": "Cookie from a logged-in browser. Read from the WP_ADMIN_COOKIE env var; export it before running.",
      "sensitive": true
    }
  ],
  "jobs": [
    {
      "id": "front",
      "name": "wordpress front page",
      "notes": "Cheapest request on the site. If this is fast but 'single post' is slow, a page cache is serving the front end and WordPress itself is untested.",
      "safety": "read",
      "job": {
        "name": "wordpress front page",
        "executor": "http",
        "target": {
          "url": "{{url}}/"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "single-post",
      "name": "wordpress single post (uncached)",
      "notes": "The honest app-tier test. Forces PHP plus a database query per request by sending no-cache.",
      "safety": "read",
      "job": {
        "name": "wordpress single post (uncached)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        }
      }
    },
    {
      "id": "rest-posts",
      "name": "wordpress REST API posts",
      "notes": "Serialises many posts through PHP, so it is markedly heavier than the front page. Good proxy for headless or API-driven use.",
      "safety": "read",
      "job": {
        "name": "wordpress REST API posts",
        "executor": "http",
        "target": {
          "url": "{{url}}/wp-json/wp/v2/posts?per_page=10"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "rest-single",
      "name": "wordpress REST API single post",
      "notes": "One REST object: the API path most theme front ends actually use.",
      "safety": "read",
      "job": {
