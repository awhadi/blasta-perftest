          "Accept": "application/rss+xml"
        }
      }
    },
    {
      "id": "admin",
      "name": "wordpress wp-admin dashboard",
      "notes": "Admin screens run far more PHP per request and each one opens a database connection. Needs {{adminCookie}}. Still writes (transients, session meta), so staging only.",
      "safety": "mutating",
      "job": {
        "name": "wordpress wp-admin dashboard",
        "executor": "http",
        "target": {
          "url": "{{url}}/wp-admin/"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 5,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cookie": "{{adminCookie}}"
        }
      }
    },
    {
      "id": "capacity-ramp",
      "name": "wordpress capacity ramp",
      "notes": "Linear ramp to 200 rps over two minutes, then holds. Watch p99, not the average: that is where the knee is. Raise 200 to your expected peak.",
      "safety": "read",
      "job": {
        "name": "wordpress capacity ramp",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 100,
        "rps": 200,
        "duration": 180000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "headers": {
          "Cache-Control": "no-cache"
        },
        "ramp": 120000000000
      }
    },
    {
      "id": "soak",
      "name": "wordpress 10 minute soak",
      "notes": "Steady load long enough to surface PHP-FPM pool exhaustion, MySQL connection leaks and cache decay that a short run never reaches.",
      "safety": "read",
      "job": {
        "name": "wordpress 10 minute soak",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 30,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Cache-Control": "no-cache"
        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "WordPress: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "WordPress: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 4,
        "rps": 5,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "WordPress: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "WordPress: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "WordPress: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 80,
        "rps": 100,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "WordPress: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 250,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 1250,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "WordPress: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 07 recovery after the spike",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "WordPress: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 08 soak (1 hour at 60%)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 12,
        "rps": 15,
        "duration": 3600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "WordPress: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 09 breakpoint (find the ceiling)",
        "executor": "http",
        "target": {
          "url": "{{url}}/{{post}}/"
        },
        "method": "GET",
        "concurrency": 400,
        "rps": 500,
        "duration": 1380000000000,
        "timeout": 15000000000,
        "queueSize": 2500,
        "onQueueFull": "reject",
        "maxWorkers": 800,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "WordPress: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: wordpress single post (uncached).",
      "safety": "read",
      "job": {
        "name": "WordPress: 10 resilience window (failover / deploy)",
