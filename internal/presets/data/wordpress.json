        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 900000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html",
          "Cache-Control": "no-cache",
          "Pragma": "no-cache"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
