{
  "id": "etcd",
  "title": "etcd",
  "category": "Infrastructure",
  "summary": "Health, version and key-value reads and writes through the gRPC gateway. Includes an enterprise test plan (jobs starting ent-).",
  "stack": "etcd v3",
  "variables": [
    {
      "name": "url",
      "default": "http://etcd.example.com:2379",
      "description": "etcd client URL, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    }
  ],
  "jobs": [
    {
      "id": "health",
      "name": "health",
      "notes": "Fails when the member has no leader or the quorum is lost.",
      "safety": "read",
      "job": {
        "name": "health",
        "executor": "http",
        "target": {
          "url": "{{url}}/health"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ]
      }
    },
    {
      "id": "version",
      "name": "version",
      "notes": "Cheapest call.",
      "safety": "read",
      "job": {
        "name": "version",
        "executor": "http",
        "target": {
          "url": "{{url}}/version"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ]
      }
    },
    {
      "id": "range",
      "name": "key read (linearizable)",
      "notes": "Linearizable reads go through the leader. Kubernetes API servers do this constantly.",
      "safety": "read",
      "job": {
        "name": "key read (linearizable)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 100,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}"
      }
    },
    {
      "id": "range-serializable",
      "name": "key read (serializable)",
      "notes": "Served by any member without asking the leader: faster, possibly stale.",
      "safety": "read",
      "job": {
        "name": "key read (serializable)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 200,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\",\"serializable\":true}"
      }
    },
    {
      "id": "put",
      "name": "key write",
      "notes": "Every write is a Raft round trip plus an fsync, so latency is bounded by disk speed. Writes key 'blasta'. Test cluster only.",
      "safety": "write",
      "job": {
        "name": "key write",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/put"
        },
        "method": "POST",
        "concurrency": 10,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\",\"value\":\"dmFsdWU=\"}"
      }
    },
    {
      "id": "metrics",
      "name": "metrics scrape",
      "notes": "Large Prometheus body; includes the disk fsync and Raft proposal histograms you should be watching during the write test.",
      "safety": "read",
      "job": {
        "name": "metrics scrape",
        "executor": "http",
        "target": {
          "url": "{{url}}/metrics"
        },
        "method": "GET",
        "concurrency": 2,
        "rps": 2,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ]
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "etcd: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "etcd: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 4,
        "rps": 20,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "etcd: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 100,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "etcd: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 40,
        "rps": 200,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "etcd: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 80,
        "rps": 400,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 2000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "etcd: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 200,
        "rps": 1000,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "etcd: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 07 recovery after the spike",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 100,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "etcd: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 08 soak (1 hour at 60%)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 12,
        "rps": 60,
        "duration": 3600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "etcd: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 09 breakpoint (find the ceiling)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 400,
        "rps": 2000,
        "duration": 1380000000000,
        "timeout": 15000000000,
        "queueSize": 10000,
        "onQueueFull": "reject",
        "maxWorkers": 800,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "etcd: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: 10 resilience window (failover / deploy)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 100,
        "duration": 900000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-api-server-read-peak",
      "name": "etcd: control-plane read peak",
      "notes": "Five times normal reads for 10 minutes: Kubernetes API servers and controllers hammer etcd. Reference request: key read (linearizable).",
      "safety": "read",
      "job": {
        "name": "etcd: control-plane read peak",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/range"
        },
        "method": "POST",
        "concurrency": 100,
        "rps": 500,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 2500,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\"}",
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-write-peak",
      "name": "etcd: write peak",
      "notes": "Twice normal writes for 10 minutes. Latency is bounded by the disk's fsync time. Reference request: key write. This job WRITES or creates data on every request: staging only, and expect a lot of rows.",
      "safety": "write",
      "job": {
        "name": "etcd: write peak",
        "executor": "http",
        "target": {
          "url": "{{url}}/v3/kv/put"
        },
        "method": "POST",
        "concurrency": 20,
        "rps": 100,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"key\":\"Ymxhc3Q=\",\"value\":\"dmFsdWU=\"}",
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    }
  ]
}
