{
  "id": "observability",
  "title": "Grafana and Prometheus",
  "category": "Operations",
  "summary": "Dashboards API, health and PromQL queries. Includes an enterprise test plan (jobs starting ent-).",
  "description": "Load tests Grafana and Prometheus: the Grafana health API and login page, Prometheus health, an instant query and a one-hour range query. It shows how dashboards and queries behave when many people open them at once.",
  "stack": "Grafana, Prometheus",
  "variables": [
    {
      "name": "url",
      "default": "http://localhost:3000",
      "description": "Base URL of the service, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    },
    {
      "name": "promql",
      "default": "up",
      "description": "A PromQL expression",
      "guide": "A PromQL expression that returns data, for example up."
    }
  ],
  "jobs": [
    {
      "id": "grafana-health",
      "name": "grafana /api/health",
      "notes": "Liveness plus a database ping.",
      "safety": "read",
      "job": {
        "name": "grafana /api/health",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/health"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "grafana-login",
      "name": "grafana login page",
      "notes": "Single page app shell.",
      "safety": "read",
      "job": {
        "name": "grafana login page",
        "executor": "http",
        "target": {
          "url": "{{url}}/login"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "prom-healthy",
      "name": "prometheus /-/healthy",
      "notes": "Liveness.",
      "safety": "read",
      "job": {
        "name": "prometheus /-/healthy",
        "executor": "http",
        "target": {
          "url": "{{url}}/-/healthy"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ]
      }
    },
    {
      "id": "prom-instant",
      "name": "prometheus instant query",
      "notes": "What an alert rule evaluation does. Cost depends on cardinality, not rate.",
      "safety": "read",
      "job": {
        "name": "prometheus instant query",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "prom-range",
      "name": "prometheus range query (1h)",
      "notes": "What a dashboard panel does. Heavy: one dashboard with 30 panels is 30 of these at once. Keep the rate low.",
      "safety": "read",
      "job": {
        "name": "prometheus range query (1h)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query_range?query={{promql}}&start=2026-01-01T00:00:00Z&end=2026-01-01T01:00:00Z&step=15"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 5,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "Grafana and Prometheus: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "Grafana and Prometheus: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 2,
        "rps": 4,
        "duration": 300000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "Grafana and Prometheus: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 600000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "Grafana and Prometheus: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 40,
        "duration": 600000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "Grafana and Prometheus: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 80,
        "duration": 720000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "Grafana and Prometheus: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 100,
        "rps": 200,
        "duration": 130000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "Grafana and Prometheus: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 07 recovery after the spike",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 300000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "Grafana and Prometheus: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 08 soak (1 hour at 60%)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 6,
        "rps": 12,
        "duration": 3600000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "Grafana and Prometheus: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 09 breakpoint (find the ceiling)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 400,
        "duration": 1380000000000,
        "timeout": 30000000000,
        "queueSize": 2000,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "Grafana and Prometheus: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: 10 resilience window (failover / deploy)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 900000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-connection-close",
      "name": "Grafana and Prometheus: no keep-alive (new connection per request)",
      "notes": "Sends Connection: close, so every request pays for a new TCP and TLS handshake: the cost for clients that do not reuse connections (scripts, some mobile SDKs, health checkers). Shows load balancer and TLS termination limits. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: no keep-alive (new connection per request)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 300000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Connection": "close"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1500000000,
          "maxP99": 3000000000
        }
      }
    },
    {
      "id": "ent-x-bot-traffic",
      "name": "Grafana and Prometheus: crawler traffic (Googlebot user agent)",
      "notes": "Same request identified as a search crawler. Tests WAF and bot-management rules and whether crawlers get cached or origin responses. Crawlers can easily be a third of all traffic. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: crawler traffic (Googlebot user agent)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 300000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "User-Agent": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-large-headers",
      "name": "Grafana and Prometheus: large cookies (~4 KB header)",
      "notes": "Adds a 4 KB Cookie header, like a logged-in user with many tracking cookies. Proxies and servers reject headers around 8 KB, so this shows how close you are to that limit. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: large cookies (~4 KB header)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 10,
        "duration": 300000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/json",
          "Cookie": ""
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-monitor-storm",
      "name": "Grafana and Prometheus: uptime monitors (HEAD from many locations)",
      "notes": "A fleet of synthetic monitors checking the URL with HEAD requests every 30 seconds from 20 locations, plus load balancer probes. Cheap each, constant in total. Reference request: prometheus instant query.",
      "safety": "read",
      "job": {
        "name": "Grafana and Prometheus: uptime monitors (HEAD from many locations)",
        "executor": "http",
        "target": {
          "url": "{{url}}/api/v1/query?query={{promql}}"
        },
        "method": "HEAD",
        "concurrency": 10,
        "rps": 20,
        "duration": 600000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          204,
          301,
          302,
          304,
          405
        ],
        "headers": {
          "Accept": "application/json"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    }
  ]
}
