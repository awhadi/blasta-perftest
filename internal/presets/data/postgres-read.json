{
  "id": "postgres-read",
  "title": "PostgreSQL reads",
  "category": "Database",
  "summary": "Read-only queries. Writes are refused unless allowed. Includes an enterprise test plan (jobs starting ent-).",
  "description": "Load tests PostgreSQL with read-only queries: a single-row select, count(*), an indexed lookup, a two-table join and pool saturation. Writes are refused unless you allow them, so it is safe to point at real data.",
  "stack": "PostgreSQL",
  "variables": [
    {
      "name": "table",
      "default": "wp_posts",
      "description": "An existing table to read",
      "guide": "A table that exists in your database, for example orders. Use a throwaway table for write jobs."
    }
  ],
  "jobs": [
    {
      "id": "select-one",
      "name": "postgres single-row select",
      "notes": "Cheapest possible round trip: isolates connection and network overhead from query cost.",
      "safety": "read",
      "job": {
        "name": "postgres single-row select",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT 1 AS one"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 100,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        }
      }
    },
    {
      "id": "count",
      "name": "postgres count(*)",
      "notes": "A full scan on a large table. The usual first query to fall over.",
      "safety": "read",
      "job": {
        "name": "postgres count(*)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT COUNT(*) FROM {{table}}"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        }
      }
    },
    {
      "id": "indexed",
      "name": "postgres indexed lookup",
      "notes": "An indexed predicate, to separate index performance from full scans.",
      "safety": "read",
      "job": {
        "name": "postgres indexed lookup",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        }
      }
    },
    {
      "id": "join",
      "name": "postgres two-table join",
      "notes": "Representative application read. Tune the predicates to your schema.",
      "safety": "read",
      "job": {
        "name": "postgres two-table join",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT a.id FROM {{table}} a JOIN {{table}} b ON a.id = b.id LIMIT 100"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 25,
        "duration": 60000000000,
        "timeout": 30000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        }
      }
    },
    {
      "id": "pool-saturation",
      "name": "postgres pool saturation",
      "notes": "Concurrency deliberately above maxOpen so you can watch connection pressure. Run alongside an app-level test to see which saturates first.",
      "safety": "read",
      "job": {
        "name": "postgres pool saturation",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT 1 AS one"
          }
        },
        "method": "GET",
        "concurrency": 64,
        "rps": 200,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 8,
          "allowWrite": false
        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "PostgreSQL reads: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 01 smoke",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "PostgreSQL reads: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 02 baseline (20% load)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 2,
        "rps": 10,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 250000000,
          "maxP99": 1000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "PostgreSQL reads: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 03 average load (SLO check)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 250000000,
          "maxP99": 1000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "PostgreSQL reads: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 04 peak load (2x average)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 100,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 500000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "PostgreSQL reads: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 05 stress (ramp to 4x)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 200,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "PostgreSQL reads: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 06 spike (10x in 10 s)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 100,
        "rps": 500,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 2500,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "PostgreSQL reads: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 07 recovery after the spike",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 250000000,
          "maxP99": 1000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "PostgreSQL reads: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 08 soak (1 hour at 60%)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 6,
        "rps": 30,
        "duration": 3600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 250000000,
          "maxP99": 1000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "PostgreSQL reads: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 09 breakpoint (find the ceiling)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 1000,
        "duration": 1380000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "PostgreSQL reads: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: 10 resilience window (failover / deploy)",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 900000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 250000000,
          "maxP99": 1000000000
        }
      }
    },
    {
      "id": "ent-x-pool-exhaustion",
      "name": "PostgreSQL reads: connection pool exhaustion",
      "notes": "Runs four times more workers than the pool has connections, so most requests queue for a connection. Shows how the database and your pool behave when the app is slower than the traffic: latency should rise smoothly, not fall off a cliff. Reference request: postgres indexed lookup.",
      "safety": "read",
      "job": {
        "name": "PostgreSQL reads: connection pool exhaustion",
        "executor": "sql",
        "target": {
          "url": "",
          "meta": {
            "query": "SELECT * FROM {{table}} WHERE id = 1"
          }
        },
        "method": "GET",
        "concurrency": 64,
        "rps": 100,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "db": {
          "driver": "postgres",
          "dsnEnv": "PG_DSN",
          "maxOpen": 16,
          "allowWrite": false
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 1000000000,
          "maxP99": 4000000000
        }
      }
    }
  ]
}
