        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "SAML 2.0 IdP (any provider): 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: SP-initiated SSO (HTTP-Redirect binding).",
      "safety": "read",
      "job": {
        "name": "SAML 2.0 IdP (any provider): 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "SAML 2.0 IdP (any provider): 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: SP-initiated SSO (HTTP-Redirect binding).",
      "safety": "read",
      "job": {
        "name": "SAML 2.0 IdP (any provider): 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 2,
        "rps": 4,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "SAML 2.0 IdP (any provider): 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: SP-initiated SSO (HTTP-Redirect binding).",
      "safety": "read",
      "job": {
        "name": "SAML 2.0 IdP (any provider): 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "SAML 2.0 IdP (any provider): 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: SP-initiated SSO (HTTP-Redirect binding).",
      "safety": "read",
      "job": {
        "name": "SAML 2.0 IdP (any provider): 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 40,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "SAML 2.0 IdP (any provider): 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: SP-initiated SSO (HTTP-Redirect binding).",
      "safety": "read",
      "job": {
        "name": "SAML 2.0 IdP (any provider): 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 80,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "SAML 2.0 IdP (any provider): 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: SP-initiated SSO (HTTP-Redirect binding).",
      "safety": "read",
      "job": {
        "name": "SAML 2.0 IdP (any provider): 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 100,
        "rps": 200,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "SAML 2.0 IdP (any provider): 07 recovery after the spike",
