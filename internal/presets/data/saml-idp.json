{
  "id": "saml-idp",
  "title": "SAML 2.0 IdP (any provider)",
  "category": "SAML",
  "summary": "Metadata, SP-initiated SSO in both bindings, passive and forced login, unknown and malformed requests, logout, spike and ramp. Includes an enterprise test plan (jobs starting ent-).",
  "stack": "Any SAML 2.0 identity provider",
  "variables": [
    {
      "name": "metadataUrl",
      "default": "https://idp.example.com/saml/metadata",
      "description": "URL of the IdP's SAML metadata",
      "placeholder": true,
      "guide": "Where the IdP publishes its SAML metadata. Keycloak: /realms/<realm>/protocol/saml/descriptor. Shibboleth: /idp/shibboleth. AD FS: /FederationMetadata/2007-06/FederationMetadata.xml."
    },
    {
      "name": "ssoUrl",
      "default": "https://idp.example.com/saml/sso",
      "description": "The IdP single sign-on URL (HTTP-Redirect / POST binding)",
      "placeholder": true,
      "guide": "The IdP's single sign-on address. Open the IdP's metadata XML and find <SingleSignOnService> with the HTTP-Redirect binding: its Location is this value."
    },
    {
      "name": "sloUrl",
      "default": "https://idp.example.com/saml/slo",
      "description": "The IdP single logout URL",
      "placeholder": true,
      "guide": "The IdP's single logout address. In the metadata XML, <SingleLogoutService> with the HTTP-Redirect binding: its Location."
    },
    {
      "name": "spEntityId",
      "default": "https://sp.example.com/saml/metadata",
      "description": "Entity ID of a service provider registered at the IdP",
      "placeholder": true,
      "guide": "The entity ID of a service provider that is REGISTERED at the IdP. In the IdP's SAML client or relying-party list, copy its entity ID (or client ID). An unregistered one is refused."
    },
    {
      "name": "acsUrl",
      "default": "https://sp.example.com/saml/acs",
      "description": "That service provider's assertion consumer URL",
      "placeholder": true,
      "guide": "That service provider's assertion consumer service address, from its registration at the IdP (it must match exactly)."
    },
    {
      "name": "nameId",
      "default": "blasta-test-user",
      "description": "NameID used in logout requests",
      "guide": "Any user name or ID. It is only used in logout requests."
    },
    {
      "name": "samlRequest",
      "default": "",
      "description": "AuthnRequest, HTTP-Redirect binding (built when rendered)",
      "derived": "saml-authnrequest-redirect"
    },
    {
      "name": "samlRequestPassive",
      "default": "",
      "description": "AuthnRequest with IsPassive",
      "derived": "saml-authnrequest-redirect-passive"
    },
    {
      "name": "samlRequestForce",
      "default": "",
      "description": "AuthnRequest with ForceAuthn",
      "derived": "saml-authnrequest-redirect-force"
    },
    {
      "name": "samlRequestPost",
      "default": "",
      "description": "AuthnRequest, HTTP-POST binding",
      "derived": "saml-authnrequest-post"
    },
    {
      "name": "samlRequestUnknownSp",
      "default": "",
      "description": "AuthnRequest from an unregistered SP",
      "derived": "saml-authnrequest-redirect-unknownsp"
    },
    {
      "name": "samlLogout",
      "default": "",
      "description": "LogoutRequest, HTTP-Redirect binding",
      "derived": "saml-logoutrequest-redirect"
    },
    {
      "name": "idpInitiatedUrl",
      "default": "https://idp.example.com/saml/idp-initiated?sp=sp",
      "description": "IdP-initiated SSO URL for a registered SP",
      "placeholder": true,
      "guide": "The IdP-initiated login address for a registered application. Keycloak: /realms/<realm>/protocol/saml/clients/<client URL name>. Shibboleth: /idp/profile/SAML2/Unsolicited/SSO?providerId=<entity ID>."
    }
  ],
  "jobs": [
    {
      "id": "metadata",
      "name": "IdP metadata",
      "notes": "Fetched by every SP at start-up and refreshed on a timer; with many SPs it is polled constantly.",
      "safety": "read",
      "job": {
        "name": "IdP metadata",
        "executor": "http",
        "target": {
          "url": "{{metadataUrl}}"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 30,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Accept": "application/samlmetadata+xml, application/xml"
        }
      }
    },
    {
      "id": "metadata-nocache",
      "name": "IdP metadata (cache bypass)",
      "notes": "Forces the origin to generate and sign the metadata.",
      "safety": "read",
      "job": {
        "name": "IdP metadata (cache bypass)",
        "executor": "http",
        "target": {
          "url": "{{metadataUrl}}"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 10,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "Cache-Control": "no-cache",
          "Pragma": "no-cache",
          "Accept": "application/xml"
        }
      }
    },
    {
      "id": "sso-redirect",
      "name": "SP-initiated SSO (HTTP-Redirect binding)",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. The start of every SAML login: the IdP parses the request, looks up the SP and shows a login page or continues an existing session. Redirects are not followed.",
      "safety": "read",
      "job": {
        "name": "SP-initiated SSO (HTTP-Redirect binding)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "sso-post",
      "name": "SP-initiated SSO (HTTP-POST binding)",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Same login, sent as a form POST. Some IdPs handle the two bindings in different code paths.",
      "safety": "read",
      "job": {
        "name": "SP-initiated SSO (HTTP-POST binding)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "POST",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Content-Type": "application/x-www-form-urlencoded",
          "Accept": "text/html"
        },
        "body": "SAMLRequest={{samlRequestPost}}&RelayState=blasta"
      }
    },
    {
      "id": "sso-passive",
      "name": "passive SSO (IsPassive)",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Must answer WITHOUT showing a login page: either a response or a NoPassive status. Used by silent session checks.",
      "safety": "read",
      "job": {
        "name": "passive SSO (IsPassive)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequestPassive}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "sso-force-authn",
      "name": "forced re-authentication (ForceAuthn)",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Ignores the existing session and demands a fresh login: the login page is rendered every time.",
      "safety": "read",
      "job": {
        "name": "forced re-authentication (ForceAuthn)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequestForce}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 15,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "sso-unknown-sp",
      "name": "request from an unknown SP",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Error path: an unregistered entity ID must be refused cheaply with an error page, never redirected to its ACS URL.",
      "safety": "read",
      "job": {
        "name": "request from an unknown SP",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequestUnknownSp}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          400,
          403,
          404
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "sso-malformed",
      "name": "malformed SAMLRequest",
      "notes": "Garbage that is not deflated XML. The IdP must answer with a 4xx or an error page and must not log stack traces per request or crash.",
      "safety": "read",
      "job": {
        "name": "malformed SAMLRequest",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest=bm90LXNhbWw%3D&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          400,
          403
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "sso-missing-request",
      "name": "SSO endpoint with no request",
      "notes": "Bots and health checks hit the SSO URL bare. It should return an error page quickly.",
      "safety": "read",
      "job": {
        "name": "SSO endpoint with no request",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 30,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          400,
          403,
          404,
          405
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "slo-redirect",
      "name": "single logout request (HTTP-Redirect)",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Logout of a session that does not exist: should return a logout response or an error page quickly. The SP also needs a single-logout URL registered at the IdP: in testing, a Keycloak client without one answered 500 ('uri parameter is null') instead of a clean error, which this job will show as errors.",
      "safety": "read",
      "job": {
        "name": "single logout request (HTTP-Redirect)",
        "executor": "http",
        "target": {
          "url": "{{sloUrl}}?SAMLRequest={{samlLogout}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 15,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303,
          400
        ],
        "headers": {
          "Accept": "text/html"
        }
      }
    },
    {
      "id": "sso-spike",
      "name": "login spike (10x in 10 s)",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Everyone logs in at 09:00. Reaches a high rate in ten seconds and holds, then watch recovery.",
      "safety": "read",
      "job": {
        "name": "login spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 300,
        "duration": 120000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 500,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "ramp": 10000000000
      }
    },
    {
      "id": "sso-ramp",
      "name": "login capacity ramp",
      "notes": "The AuthnRequest is generated when you render this template, unsigned, with a fresh ID and the current time: render it shortly before the run, and register the SP entity ID at the IdP first. Slow ramp to find the rate where the IdP's latency climbs. Staging only.",
      "safety": "read",
      "job": {
        "name": "login capacity ramp",
        "executor": "http",
        "target": {
          "url": "{{ssoUrl}}?SAMLRequest={{samlRequest}}&RelayState=blasta",
          "meta": {
            "followRedirects": false
          }
        },
        "method": "GET",
        "concurrency": 100,
        "rps": 100,
        "duration": 420000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 300,
        "blockPrivate": false,
        "expectStatus": [
          200,
          302,
          303
        ],
        "headers": {
          "Accept": "text/html"
        },
        "ramp": 300000000000
      }
    },
    {
      "id": "idp-initiated",
      "name": "IdP-initiated SSO",
      "notes": "Login that starts at the IdP portal. Needs an existing session to produce a response, so without one it returns the login page.",
      "safety": "read",
      "job": {
        "name": "IdP-initiated SSO",
        "executor": "http",
        "target": {
          "url": "{{idpInitiatedUrl}}",
          "meta": {
