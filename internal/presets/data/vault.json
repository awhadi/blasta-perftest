{
  "id": "vault",
  "title": "HashiCorp Vault",
  "category": "Infrastructure",
  "summary": "Health, seal status and token lookups. Includes an enterprise test plan (jobs starting ent-).",
  "description": "Load tests HashiCorp Vault: the health and seal-status endpoints, token lookup, KV v2 secret reads and writes, and a request with an invalid token. It shows how token validation and secret access scale. The write job creates a secret, so use a test Vault.",
  "stack": "Vault",
  "variables": [
    {
      "name": "url",
      "default": "https://vault.example.com:8200",
      "description": "Vault URL, no trailing slash",
      "placeholder": true,
      "guide": "The address of the system to test, starting with https:// (or http://) and with no trailing slash, for example https://staging.example.com. Use a system you own, ideally a staging copy. BLASTA runs in a container, so for a service on your own machine use host.docker.internal instead of localhost."
    },
    {
      "name": "token",
      "default": "${VAULT_TOKEN}",
      "description": "A token. Read from VAULT_TOKEN by the CLI.",
      "sensitive": true
    }
  ],
  "jobs": [
    {
      "id": "health",
      "name": "sys/health",
      "notes": "Vault answers with a status code per state: 200 active, 429 standby, 472 and 473 DR/performance standby. Standby counts as healthy here.",
      "safety": "read",
      "job": {
        "name": "sys/health",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/sys/health"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 30,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          429,
          472,
          473
        ]
      }
    },
    {
      "id": "seal-status",
      "name": "sys/seal-status",
      "notes": "Unauthenticated seal state.",
      "safety": "read",
      "job": {
        "name": "sys/seal-status",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/sys/seal-status"
        },
        "method": "GET",
        "concurrency": 5,
        "rps": 30,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ]
      }
    },
    {
      "id": "token-lookup",
      "name": "auth/token/lookup-self",
      "notes": "Token validation, the call apps make before using a secret. Needs a token.",
      "safety": "read",
      "job": {
        "name": "auth/token/lookup-self",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        }
      }
    },
    {
      "id": "kv-read",
      "name": "secret read (KV v2)",
      "notes": "Reading a secret from secret/data/blasta. Every read is audit-logged, so a slow audit device slows Vault.",
      "safety": "read",
      "job": {
        "name": "secret read (KV v2)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/secret/data/blasta"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          404
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        }
      }
    },
    {
      "id": "kv-write",
      "name": "secret write (KV v2)",
      "notes": "Writes secret/data/blasta. Test namespace only.",
      "safety": "write",
      "job": {
        "name": "secret write (KV v2)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/secret/data/blasta"
        },
        "method": "POST",
        "concurrency": 5,
        "rps": 20,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          204
        ],
        "headers": {
          "X-Vault-Token": "{{token}}",
          "Content-Type": "application/json"
        },
        "body": "{\"data\":{\"k\":\"v\"}}"
      }
    },
    {
      "id": "invalid-token",
      "name": "request with an invalid token",
      "notes": "Must be a fast 403.",
      "safety": "read",
      "job": {
        "name": "request with an invalid token",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 60000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          403
        ],
        "headers": {
          "X-Vault-Token": "blasta-invalid"
        }
      }
    },
    {
      "id": "ent-01-smoke",
      "name": "HashiCorp Vault: 01 smoke",
      "notes": "Enterprise plan, step 1 of 10. One request a second for 30 seconds. Run this first, every time: it proves the address, credentials and headers are right and that the environment is up before any real load is applied. Gate: zero errors. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 01 smoke",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 1,
        "rps": 1,
        "duration": 30000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 0
        }
      }
    },
    {
      "id": "ent-02-baseline",
      "name": "HashiCorp Vault: 02 baseline (20% load)",
      "notes": "Step 2 of 10. About a fifth of normal traffic for 5 minutes: the uncontended latency of this request. Every later result is judged against it, so record p50 and p95. Gate: at most 0.5% errors and the default latency targets. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 02 baseline (20% load)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 2,
        "rps": 10,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-03-average-load",
      "name": "HashiCorp Vault: 03 average load (SLO check)",
      "notes": "Step 3 of 10. Normal busy-hour traffic for 10 minutes. The rate is the reference job's rate: raise it to your measured production peak-hour rate. This is the run that proves (or breaks) your SLO. Gate: at most 1% errors, p95 and p99 inside the targets. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 03 average load (SLO check)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-04-peak-load",
      "name": "HashiCorp Vault: 04 peak load (2x average)",
      "notes": "Step 4 of 10. Twice the average for 10 minutes: the busiest hour of the year plus headroom. Latency may rise, but must stay in SLO; if it does not, you have no headroom. Gate: at most 2% errors, latency targets doubled. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 04 peak load (2x average)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 20,
        "rps": 100,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 2,
          "maxP95": 2000000000,
          "maxP99": 4000000000
        }
      }
    },
    {
      "id": "ent-05-stress",
      "name": "HashiCorp Vault: 05 stress (ramp to 4x)",
      "notes": "Step 5 of 10. Ramps to four times average over 10 minutes, then holds for 2. Finds where it degrades and HOW: gracefully (latency rises, errors stay low) or badly (errors, timeouts, crashes, restarts). Observation only, no gate. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 05 stress (ramp to 4x)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 40,
        "rps": 200,
        "duration": 720000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "ramp": 600000000000
      }
    },
    {
      "id": "ent-06-spike",
      "name": "HashiCorp Vault: 06 spike (10x in 10 s)",
      "notes": "Step 6 of 10. Reaches ten times average within 10 seconds and holds for 2 minutes: a campaign email, a news link, a failover. Checks autoscaling, queue limits and load shedding. Gate: at most 5% errors, because shedding load is acceptable and crashing is not. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 06 spike (10x in 10 s)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 100,
        "rps": 500,
        "duration": 130000000000,
        "timeout": 15000000000,
        "queueSize": 2500,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "ramp": 10000000000,
        "slo": {
          "maxErrorRate": 5
        }
      }
    },
    {
      "id": "ent-07-recovery",
      "name": "HashiCorp Vault: 07 recovery after the spike",
      "notes": "Step 7 of 10. Run IMMEDIATELY after the spike, at average load for 5 minutes. Latency and errors must return to the baseline from step 2. If they do not, something is stuck: queues, connection pools, GC, an autoscaler cool-down. Gate: same as average load. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 07 recovery after the spike",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-08-soak",
      "name": "HashiCorp Vault: 08 soak (1 hour at 60%)",
      "notes": "Step 8 of 10. One hour of steady load. Finds leaks and slow decay in memory, connections, file descriptors, disk, log volume and cache churn. Watch the resource graphs: any line that climbs and never flattens is a finding. Gate: at most 0.5% errors. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 08 soak (1 hour at 60%)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 6,
        "rps": 30,
        "duration": 3600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-09-breakpoint",
      "name": "HashiCorp Vault: 09 breakpoint (find the ceiling)",
      "notes": "Step 9 of 10. Ramps to twenty times average over 20 minutes. Stop it when errors pass about 5%: the rate at that moment is your ceiling, and ceiling divided by peak is your capacity margin. Use a production-like environment, never production. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 09 breakpoint (find the ceiling)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 200,
        "rps": 1000,
        "duration": 1380000000000,
        "timeout": 15000000000,
        "queueSize": 5000,
        "onQueueFull": "reject",
        "maxWorkers": 400,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "ramp": 1200000000000
      }
    },
    {
      "id": "ent-10-failover-window",
      "name": "HashiCorp Vault: 10 resilience window (failover / deploy)",
      "notes": "Step 10 of 10. Average load for 15 minutes. About 5 minutes in, cause the event you are testing: kill a pod or node, fail over the database, roll out a new version, drain a zone. Errors in the window are your real availability loss. Gate: at most 1% errors overall; read the time series for how long the dip lasted. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: 10 resilience window (failover / deploy)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 900000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-connection-close",
      "name": "HashiCorp Vault: no keep-alive (new connection per request)",
      "notes": "Sends Connection: close, so every request pays for a new TCP and TLS handshake: the cost for clients that do not reuse connections (scripts, some mobile SDKs, health checkers). Shows load balancer and TLS termination limits. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: no keep-alive (new connection per request)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}",
          "Connection": "close"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1500000000,
          "maxP99": 3000000000
        }
      }
    },
    {
      "id": "ent-x-bot-traffic",
      "name": "HashiCorp Vault: crawler traffic (Googlebot user agent)",
      "notes": "Same request identified as a search crawler. Tests WAF and bot-management rules and whether crawlers get cached or origin responses. Crawlers can easily be a third of all traffic. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: crawler traffic (Googlebot user agent)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 50,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}",
          "User-Agent": "Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-large-headers",
      "name": "HashiCorp Vault: large cookies (~4 KB header)",
      "notes": "Adds a 4 KB Cookie header, like a logged-in user with many tracking cookies. Proxies and servers reject headers around 8 KB, so this shows how close you are to that limit. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: large cookies (~4 KB header)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 10,
        "rps": 25,
        "duration": 300000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}",
          "Cookie": ""
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-monitor-storm",
      "name": "HashiCorp Vault: uptime monitors (HEAD from many locations)",
      "notes": "A fleet of synthetic monitors checking the URL with HEAD requests every 30 seconds from 20 locations, plus load balancer probes. Cheap each, constant in total. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: uptime monitors (HEAD from many locations)",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "HEAD",
        "concurrency": 10,
        "rps": 50,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200,
          204,
          301,
          302,
          304,
          405
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 1,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    },
    {
      "id": "ent-x-secret-read-peak",
      "name": "HashiCorp Vault: token validation peak",
      "notes": "Three times normal token lookups for 10 minutes. Every application start-up and renewal does this. Reference request: auth/token/lookup-self.",
      "safety": "read",
      "job": {
        "name": "HashiCorp Vault: token validation peak",
        "executor": "http",
        "target": {
          "url": "{{url}}/v1/auth/token/lookup-self"
        },
        "method": "GET",
        "concurrency": 30,
        "rps": 150,
        "duration": 600000000000,
        "timeout": 15000000000,
        "queueSize": 1000,
        "onQueueFull": "reject",
        "maxWorkers": 200,
        "blockPrivate": false,
        "expectStatus": [
          200
        ],
        "headers": {
          "X-Vault-Token": "{{token}}"
        },
        "slo": {
          "maxErrorRate": 0.5,
          "maxP95": 1000000000,
          "maxP99": 2000000000
        }
      }
    }
  ],
  "secrets": {
    "VAULT_TOKEN": {
      "label": "Vault token",
      "guide": "`vault token create -policy=default -ttl=2h` and copy `token`, or Access \u2192 Tokens in the Vault UI. Use a token with read access to the path the job reads."
    }
  }
}
